            <mxPoint x="885" y="292" as="targetPoint" />
            <Array as="points">
              <mxPoint x="918" y="252" />
              <mxPoint x="918" y="292" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg5" value="5: true / false (доступність Ollama)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#9333ea;strokeWidth=1.5;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="865" y="340" as="sourcePoint" />
            <mxPoint x="635" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg6" value="6: bool (статус Ollama)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#d97706;strokeWidth=1.5;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="385" as="sourcePoint" />
            <mxPoint x="385" y="385" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="msg7" value="7: Формування JSON-відповіді" style="html=1;align=left;spacingLeft=6;endArrow=block;rounded=0;strokeColor=#475569;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="385" y="415" as="sourcePoint" />
