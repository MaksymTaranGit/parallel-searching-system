            <Array as="points">
              <mxPoint x="418" y="415" />
              <mxPoint x="418" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg8" value="8: 200 OK JSON&lt;br&gt;{&quot;status&quot;: &quot;ok&quot;, &quot;ollama&quot;: true|false}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;strokeColor=#0f172a;strokeWidth=1.5;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="365" y="500" as="sourcePoint" />
            <mxPoint x="135" y="500" as="targetPoint" />
