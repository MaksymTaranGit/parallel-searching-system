# === Search Server (C++ / Crow) ===
SERVER_PORT=8080
DATASET_PATH=/app/data
WEB_DIR=/app/web

# Шлях до датасету на хост-машині (монтується у DATASET_PATH)
HOST_DATA_DIR=./data

# === Ollama LLM ===
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

# === CLI Client (для локального запуску поза Docker) ===
SEARCH_SERVER_URL=http://localhost:8080